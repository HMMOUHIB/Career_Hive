# Copy to .env and adjust. Every value has a development default except where noted.

# --- server
PORT=8000
NODE_ENV=development
# Public URL of this API (used to build OAuth callback URLs)
API_URL=http://localhost:8000
# The UI: OAuth sends users back here, and it is allowed by CORS
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated (defaults to FRONTEND_URL)
# CORS_ORIGINS=http://localhost:5173,https://careerhive.vercel.app

# --- auth
# REQUIRED in production. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Roles anyone may choose on the sign-up form ("student" = employee).
SIGNUP_ROLES=student
# The workspace owner(s): these emails become managers (and may pick HR or admin on the sign-up form).
# Change a role later with: npm run user:role -- someone@example.com manager
STAFF_EMAILS=
# Login/sign-up attempts per IP per 15 minutes
AUTH_RATE_LIMIT=30

# --- email (confirmation and password-reset links)
# Sign-in requires a confirmed email. Without SMTP_HOST the emails are printed in this API's console instead.
REQUIRE_EMAIL_VERIFICATION=true
# Gmail: turn on 2-Step Verification, create an App password (myaccount.google.com/apppasswords), then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to users (defaults to CareerHive <SMTP_USER>)
MAIL_FROM=

# --- MySQL / MariaDB (XAMPP: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careerhive
# Managed databases (PlanetScale, Aiven, Railway…) usually need TLS
DB_SSL=false

# --- course content uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500

# Time zone for chat timestamps like "11:05"
APP_TIMEZONE=Africa/Tunis

# --- social sign-in (optional; buttons redirect back with an error until set)
# Callback URLs to register with each provider: {API_URL}/api/auth/google/callback, /linkedin/callback, /github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
