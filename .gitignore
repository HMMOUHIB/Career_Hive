careerhive-backend/uploads/
*.log

# presentation: intermediate HTML regenerated by build.mjs and film.mjs
presentation/source/*.html
presentation/motion/source/*.html

# editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
